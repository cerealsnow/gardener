[Unit]
# The Docker socket from the host is mounted into the machine pod at /host-docker.sock (not
# /var/run/docker.sock) because systemd inside the container mounts a fresh tmpfs on /run at
# boot, which would shadow any bind mount placed under /run by the container runtime.
# This unit creates a symlink at the conventional path after systemd's /run tmpfs is in place.
Description=Symlink Docker socket from host mount into /var/run
DefaultDependencies=no
Before=run-userdata.service containerd.service

[Service]
Type=oneshot
ExecStart=/bin/ln -sf /host-docker.sock /var/run/docker.sock
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
